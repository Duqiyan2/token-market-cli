# Deployment inputs deliberately unset. Copy into a protected CI environment.
OSS_REGION=
OSS_ENDPOINT=
TOKEN_MARKET_UPDATE_OSS_BUCKET=
TOKEN_MARKET_UPDATE_OSS_PREFIX=
TOKEN_MARKET_UPDATE_PUBLIC_BASE_URL=
TOKEN_MARKET_UPDATE_PRODUCTION_MANIFEST_KEY=
TOKEN_MARKET_UPDATE_RECOVERY_KEY=
# Exact owner/repository and JSON mapping of both targets to native workflow paths.
TOKEN_MARKET_UPDATE_TRUSTED_BUILD_REPOSITORY=
TOKEN_MARKET_UPDATE_TRUSTED_BUILD_WORKFLOWS=
# Exact oss://bucket/prefix and owner/repository/.github/workflows/file.yml@refs/heads/main.
TOKEN_MARKET_UPDATE_PUBLISH_DESTINATION=
TOKEN_MARKET_UPDATE_PROMOTION_WORKFLOW_REF=
# Set to the documented shared workflow concurrency group only inside that job.
TOKEN_MARKET_UPDATE_PUBLISH_CONCURRENCY=
# Compile-time routes and public key; provide identical values to each native build.
TOKEN_MARKET_UPDATER_ENDPOINT=
TOKEN_MARKET_UPDATER_RECOVERY_URL=
TOKEN_MARKET_UPDATER_PUBLIC_KEY=
# CI-only signing and native ossutil identity. Never commit filled values.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
OSSUTIL_CONFIG_FILE=
OSSUTIL_PROFILE=
